
from math import factorial
import matplotlib.pyplot as plt
import numpy as np
from scipy.special import lpmv


def draw_angular_densities(mode_list):
    polar_pts = np.linspace(0, np.pi, 130)
    azimuth_pts = np.linspace(0, 2 * np.pi, 130)

    polar_grid, azimuth_grid = np.meshgrid(polar_pts, azimuth_pts)

    canvas = plt.figure(figsize=(14, 10))

    for slot, (deg, order) in enumerate(mode_list):
        mag_m = abs(order)

        scale = np.sqrt(
            ((2 * deg + 1) / (4 * np.pi))
            * (factorial(deg - mag_m) / factorial(deg + mag_m))
        )

        legendre_term = lpmv(mag_m, deg, np.cos(polar_grid))
        harmonic_fn = scale * legendre_term * np.exp(1j * order * azimuth_grid)

        density = np.abs(harmonic_fn) ** 2

        px = density * np.sin(polar_grid) * np.cos(azimuth_grid)
        py = density * np.sin(polar_grid) * np.sin(azimuth_grid)
        pz = density * np.cos(polar_grid)

        sub = canvas.add_subplot(2, 3, slot + 1, projection="3d")
        sub.plot_surface(px, py, pz, cmap="plasma", edgecolor="none")
        sub.set_title(f"deg={deg}, order={order}")

    plt.tight_layout()
    plt.show()


target_modes = [(2, 1), (1, 0), (2, 2)]
draw_angular_densities(target_modes)